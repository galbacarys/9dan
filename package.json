{
  "name": "watchface-c",
  "author": "MakeAwesomeHappen",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
    "displayName": "goface",
    "uuid": "c24e1fe7-52fb-471a-b2a3-ebf70232dbb5",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location"
    ],
    "messageKeys": [
      "ProblemSet",
      "ResetSeconds",
      "NewProblemSeconds",
      "ClockFormat",
      "TEMPERATURE",
      "CONDITIONS",
      "REQUEST_WEATHER",
      "Units"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "EASY",
          "file": "easy.bin"
        },
        {
          "type": "raw",
          "name": "INTERMEDIATE",
          "file": "intermediate.bin"
        },
        {
          "type": "raw",
          "name": "HARD",
          "file": "hard.bin"
        }
      ]
    }
  }
}